  version             Int                    @default(1)
  createdAt           DateTime               @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime               @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  inquiry             Inquiry                @relation(fields: [inquiryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceDocument      InquirySourceDocument?

  @@unique([id, inquiryId], map: "inquiry_upload_intent_id_inquiry_key")
  @@index([inquiryId, state, expiresAt, id], map: "inquiry_upload_intent_inquiry_state_expiry_idx")
  @@index([state, expiresAt, id], map: "inquiry_upload_intent_state_expiry_idx")
  @@map("inquiry_upload_intent")
}

model InquirySourceDocument {
  id               String                        @id @db.Uuid
  inquiryId        String                        @map("inquiry_id") @db.Uuid
  uploadIntentId   String                        @unique(map: "inquiry_source_document_intent_key") @map("upload_intent_id") @db.Uuid
  uploaderKind     String                        @map("uploader_kind") @db.Text
  uploadChannel    String                        @map("upload_channel") @db.Text
  storageKey       String                        @unique(map: "inquiry_source_document_storage_key_key") @map("storage_key") @db.VarChar(128)
  sha256           Bytes                         @db.ByteA
  sizeBytes        BigInt                        @map("size_bytes")
  detectedMimeType String                        @map("detected_mime_type") @db.VarChar(127)
  originalFilename String                        @map("original_filename") @db.VarChar(255)
  safetyState      String                        @default("QUARANTINED") @map("safety_state") @db.Text
  uploadedAt       DateTime                      @map("uploaded_at") @db.Timestamptz(6)
  createdAt        DateTime                      @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  inquiry          Inquiry                       @relation(fields: [inquiryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  uploadIntent     InquiryUploadIntent           @relation(fields: [uploadIntentId, inquiryId], references: [id, inquiryId], onDelete: Restrict, onUpdate: Restrict)
  scanJob          InquirySourceDocumentScanJob?

  @@unique([uploadIntentId, inquiryId], map: "inquiry_source_document_intent_inquiry_key")
  @@index([inquiryId, createdAt, id], map: "inquiry_source_document_inquiry_created_idx")
  @@index([safetyState, createdAt, id], map: "inquiry_source_document_state_created_idx")
  @@map("inquiry_source_document")
}

model InquirySourceDocumentScanJob {
  id                       String                @id @db.Uuid
  sourceDocumentId         String                @unique(map: "inquiry_source_document_scan_job_source_document_key") @map("source_document_id") @db.Uuid
  sourceStorageKey         String                @map("source_storage_key") @db.VarChar(128)
  sourceSha256             Bytes                 @map("source_sha256") @db.ByteA
  sourceSizeBytes          BigInt                @map("source_size_bytes")
  status                   String                @db.Text
  attemptCount             Int                   @default(0) @map("attempt_count")
  version                  Int                   @default(1)
  availableAt              DateTime              @default(dbgenerated("transaction_timestamp()")) @map("available_at") @db.Timestamptz(6)
  leaseTokenHash           Bytes?                @map("lease_token_hash") @db.ByteA
  leaseExpiresAt           DateTime?             @map("lease_expires_at") @db.Timestamptz(6)
  failureCode              String?               @map("failure_code") @db.Text
  engineVersion            String?               @map("engine_version") @db.VarChar(80)
  signatureDatabaseVersion String?               @map("signature_database_version") @db.VarChar(80)
  signatureDatabaseDate    DateTime?             @map("signature_database_date") @db.Timestamptz(6)
  signatureSetFingerprint  Bytes?                @map("signature_set_fingerprint") @db.ByteA
  completedJobVersion      Int?                  @map("completed_job_version")
  completedLeaseTokenHash  Bytes?                @map("completed_lease_token_hash") @db.ByteA
  finalizeFingerprint      Bytes?                @map("finalize_fingerprint") @db.ByteA
  lastAttemptAt            DateTime?             @map("last_attempt_at") @db.Timestamptz(6)
  lastScanDurationMs       Int?                  @map("last_scan_duration_ms")
  completedAt              DateTime?             @map("completed_at") @db.Timestamptz(6)
  createdAt                DateTime              @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime              @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  sourceDocument           InquirySourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([status, availableAt, createdAt, id], map: "inquiry_scan_job_queue_idx")
  @@index([status, leaseExpiresAt, id], map: "inquiry_scan_job_lease_expiry_idx")
  @@map("inquiry_source_document_scan_job")
}

model InquiryCommandIdempotency {
  id                 String     @id @db.Uuid
  actorKind          String     @map("actor_kind") @db.Text
  actorStaffUserId   String?    @map("actor_staff_user_id") @db.Uuid
  operationScope     String     @map("operation_scope") @db.VarChar(80)
  idempotencyKeyHash Bytes      @map("idempotency_key_hash") @db.ByteA
  requestHash        Bytes      @map("request_hash") @db.ByteA
  httpStatus         Int        @map("http_status") @db.SmallInt
  responseReceipt    Json       @map("response_receipt") @db.JsonB
  createdAt          DateTime   @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  expiresAt          DateTime   @map("expires_at") @db.Timestamptz(6)
  actor              StaffUser? @relation(fields: [actorStaffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([expiresAt, id], map: "inquiry_command_idempotency_expiry_idx")
  @@map("inquiry_command_idempotency")
}
