generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model StaffUser {
  id                        String                       @id @db.Uuid
  email                     String                       @db.VarChar(254)
  emailNormalized           String                       @unique(map: "staff_user_email_normalized_key") @map("email_normalized") @db.VarChar(254)
  displayName               String                       @map("display_name") @db.VarChar(120)
  passwordHash              String                       @map("password_hash")
  passwordChangeRequired    Boolean                      @default(false) @map("password_change_required")
  state                     String                       @db.Text
  authVersion               Int                          @default(1) @map("auth_version")
  blockedAt                 DateTime?                    @map("blocked_at") @db.Timestamptz(6)
  version                   Int                          @default(1)
  createdAt                 DateTime                     @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime                     @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  roles                     UserRole[]
  roleAssignments           UserRole[]                   @relation("UserRoleAssignedBy")
  sessions                  StaffSession[]
  auditEvents               AuditEvent[]                 @relation("AuditActor")
  ownedFiles                FileObject[]
  createdFileVersions       FileVersion[]                @relation("FileVersionCreator")
  createdFileLinks          FileLink[]                   @relation("FileLinkCreator")
  createdCatalogRevisions   CatalogProductRevision[]     @relation("CatalogRevisionCreator")
  submittedCatalogRevisions CatalogProductRevision[]     @relation("CatalogRevisionSubmitter")
  decidedCatalogRevisions   CatalogProductRevision[]     @relation("CatalogRevisionReviewer")
  createdProductMedia       ProductMedia[]               @relation("ProductMediaCreator")
  createdProductDocuments   ProductDocumentVersion[]     @relation("ProductDocumentCreator")
  createdProductRelations   ProductRelation[]            @relation("ProductRelationCreator")
  uploadedCatalogImports    CatalogImportRun[]           @relation("CatalogImportUploader")
  decidedCatalogImports     CatalogImportDecision[]      @relation("CatalogImportDecisionActor")
  createdSuppliers          Supplier[]                   @relation("SupplierCreator")
  updatedSuppliers          Supplier[]                   @relation("SupplierUpdater")
  supplierRevisions         SupplierRevision[]           @relation("SupplierRevisionCreator")
  createdSupplierOffers     SupplierOffer[]              @relation("SupplierOfferCreator")
  updatedSupplierOffers     SupplierOffer[]              @relation("SupplierOfferUpdater")
  supplierOfferRevisions    SupplierOfferRevision[]      @relation("SupplierOfferRevisionCreator")
  createdMatchProposals     ProductMatchProposal[]       @relation("MatchProposalCreator")
  decidedMatchProposals     ProductMatchProposal[]       @relation("MatchProposalDecider")
  supplierCommandResults    SupplierCommandIdempotency[]
  managedInquiries          Inquiry[]                    @relation("InquiryManager")
  engineeredInquiries       Inquiry[]                    @relation("InquiryEngineer")
  inquiryComments           InquiryComment[]             @relation("InquiryCommentAuthor")
  inquiryCommandResults     InquiryCommandIdempotency[]

  @@index([state, id], map: "staff_user_state_id_idx")
  @@map("staff_user")
}

model Role {
  id          String           @id @db.Uuid
  code        String           @unique(map: "role_code_key") @db.VarChar(64)
  name        String           @db.VarChar(120)
  state       String           @db.Text
  version     Int              @default(1)
  createdAt   DateTime         @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  assignments UserRole[]
  permissions RolePermission[]

  @@index([state, id], map: "role_state_id_idx")
  @@map("role")
}

model Permission {
  id          String           @id @db.Uuid
  code        String           @unique(map: "permission_code_key") @db.VarChar(80)
  description String           @db.VarChar(240)
  createdAt   DateTime         @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permission")
}

model UserRole {
  staffUserId      String     @map("staff_user_id") @db.Uuid
  roleId           String     @map("role_id") @db.Uuid
  assignedByUserId String?    @map("assigned_by_user_id") @db.Uuid
  createdAt        DateTime   @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  staffUser        StaffUser  @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  role             Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  assignedBy       StaffUser? @relation("UserRoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([staffUserId, roleId])
  @@index([roleId, staffUserId], map: "user_role_role_user_idx")
  @@map("user_role")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId, roleId], map: "role_permission_permission_role_idx")
  @@map("role_permission")
}

model StaffSession {
  id                 String    @id @db.Uuid
  staffUserId        String    @map("staff_user_id") @db.Uuid
  tokenHash          Bytes     @unique(map: "staff_session_token_hash_key") @map("token_hash") @db.ByteA
  authVersion        Int       @map("auth_version")
  absoluteExpiresAt  DateTime  @map("absolute_expires_at") @db.Timestamptz(6)
  idleTimeoutSeconds Int       @default(1800) @map("idle_timeout_seconds")
  lastSeenAt         DateTime  @map("last_seen_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revocationReason   String?   @map("revocation_reason") @db.VarChar(64)
  createdAt          DateTime  @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  staffUser          StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@index([staffUserId, revokedAt], map: "staff_session_user_revoked_idx")
  @@index([absoluteExpiresAt], map: "staff_session_absolute_expiry_idx")
  @@map("staff_session")
}

model SellerLegalEntity {
  id           String     @id @db.Uuid
  displayName  String     @map("display_name") @db.VarChar(160)
  legalName    String?    @map("legal_name") @db.VarChar(500)
  kind         String     @db.Text
  inn          String?    @db.VarChar(12)
  kpp          String?    @db.VarChar(9)
  ogrn         String?    @db.VarChar(15)
  legalAddress String?    @map("legal_address") @db.VarChar(1000)
  state        String     @db.Text
  archivedAt   DateTime?  @map("archived_at") @db.Timestamptz(6)
  version      Int        @default(1)
  createdAt    DateTime   @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  fileLinks    FileLink[]

  @@index([state, id], map: "seller_legal_entity_state_id_idx")
  @@map("seller_legal_entity")
}

model AuditEvent {
  id                     String                  @id @db.Uuid
  occurredAt             DateTime                @default(dbgenerated("transaction_timestamp()")) @map("occurred_at") @db.Timestamptz(6)
  actorKind              String                  @map("actor_kind") @db.Text
  actorUserId            String?                 @map("actor_user_id") @db.Uuid
  operatorLabel          String?                 @map("operator_label") @db.VarChar(80)
  action                 String                  @db.VarChar(80)
  entityType             String?                 @map("entity_type") @db.Text
  entityId               String?                 @map("entity_id") @db.Uuid
  outcome                String                  @db.Text
  reasonCode             String?                 @map("reason_code") @db.VarChar(64)
  requestId              String                  @map("request_id") @db.Uuid
  sourceHash             Bytes?                  @map("source_hash") @db.ByteA
  changes                Json                    @default("{}") @db.JsonB
  actor                  StaffUser?              @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  catalogImportDecisions CatalogImportDecision[] @relation("CatalogImportDecisionAudit")
  inquiryComment         InquiryComment?         @relation("InquiryCommentAudit")

  @@index([occurredAt(sort: Desc), id(sort: Desc)], map: "audit_event_occurred_id_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_event_actor_occurred_idx")
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "audit_event_entity_occurred_idx")
  @@index([requestId], map: "audit_event_request_id_idx")
  @@map("audit_event")
}

model FileObject {
  id                String             @id @db.Uuid
  ownerStaffUserId  String             @map("owner_staff_user_id") @db.Uuid
  displayName       String             @map("display_name") @db.VarChar(255)
  visibility        String             @db.Text
  state             String             @db.Text
  version           Int                @default(1)
  createdAt         DateTime           @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  owner             StaffUser          @relation(fields: [ownerStaffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  versions          FileVersion[]
  links             FileLink[]
  catalogImportRuns CatalogImportRun[] @relation("CatalogImportSourceObject")

  @@unique([id, ownerStaffUserId], map: "file_object_id_owner_key")
  @@index([ownerStaffUserId, state, id], map: "file_object_owner_state_id_idx")
  @@map("file_object")
}

model FileVersion {
  id                String                   @id @db.Uuid
  fileObjectId      String                   @map("file_object_id") @db.Uuid
  number            Int
  storageKey        String                   @unique(map: "file_version_storage_key_key") @map("storage_key") @db.VarChar(128)
  sha256            Bytes                    @db.ByteA
  sizeBytes         BigInt                   @map("size_bytes")
  mimeType          String                   @map("mime_type") @db.VarChar(127)
  originalFilename  String                   @map("original_filename") @db.VarChar(255)
  safetyState       String                   @map("safety_state") @db.Text
  createdByUserId   String                   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  fileObject        FileObject               @relation(fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy         StaffUser                @relation("FileVersionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  links             FileLink[]
  productMedia      ProductMedia[]
  productDocuments  ProductDocumentVersion[]
  catalogImportRuns CatalogImportRun[]       @relation("CatalogImportSourceVersion")

  @@unique([fileObjectId, number], map: "file_version_object_number_key")
  @@unique([id, fileObjectId], map: "file_version_id_object_key")
  @@index([fileObjectId, createdAt], map: "file_version_object_created_idx")
  @@map("file_version")
}

model FileLink {
  id                  String            @id @db.Uuid
  fileObjectId        String            @map("file_object_id") @db.Uuid
  fileVersionId       String            @map("file_version_id") @db.Uuid
  sellerLegalEntityId String            @map("seller_legal_entity_id") @db.Uuid
  visibility          String            @db.Text
  createdByUserId     String            @map("created_by_user_id") @db.Uuid
  createdAt           DateTime          @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  fileObject          FileObject        @relation(fields: [fileObjectId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fileVersion         FileVersion       @relation(fields: [fileVersionId, fileObjectId], references: [id, fileObjectId], onDelete: Restrict, onUpdate: Restrict)
  sellerLegalEntity   SellerLegalEntity @relation(fields: [sellerLegalEntityId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy           StaffUser         @relation("FileLinkCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([sellerLegalEntityId, fileVersionId], map: "file_link_seller_version_key")
  @@index([fileObjectId, sellerLegalEntityId], map: "file_link_object_seller_idx")
  @@map("file_link")
}

model Brand {
  id                     String                   @id @db.Uuid
  slug                   String                   @unique(map: "brand_slug_key") @db.VarChar(120)
  name                   String                   @db.VarChar(160)
  state                  String                   @db.Text
  version                Int                      @default(1)
  createdAt              DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  products               CatalogProduct[]         @relation("CatalogProductBrand")
  revisions              CatalogProductRevision[] @relation("CatalogRevisionBrand")
  supplierOfferRevisions SupplierOfferRevision[]

  @@index([state, name, id], map: "brand_state_name_id_idx")
  @@map("brand")
}

model Category {
  id                   String                   @id @db.Uuid
  parentId             String?                  @map("parent_id") @db.Uuid
  slug                 String                   @unique(map: "category_slug_key") @db.VarChar(120)
  name                 String                   @db.VarChar(160)
  description          String?                  @db.VarChar(2000)
  state                String                   @db.Text
  sortOrder            Int                      @default(0) @map("sort_order")
  version              Int                      @default(1)
  createdAt            DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  parent               Category?                @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  children             Category[]               @relation("CategoryTree")
  attributeDefinitions AttributeDefinition[]
  revisions            CatalogProductRevision[]

  @@index([parentId, state, sortOrder, slug], map: "category_parent_state_sort_slug_idx")
  @@index([state, id], map: "category_state_id_idx")
  @@map("category")
}

model AttributeDefinition {
  id          String                  @id @db.Uuid
  categoryId  String                  @map("category_id") @db.Uuid
  code        String                  @db.VarChar(80)
  label       String                  @db.VarChar(160)
  valueType   String                  @map("value_type") @db.Text
  unitCode    String?                 @map("unit_code") @db.VarChar(32)
  unitLabel   String?                 @map("unit_label") @db.VarChar(48)
  enumOptions Json?                   @map("enum_options") @db.JsonB
  filterable  Boolean                 @default(false)
  searchable  Boolean                 @default(false)
  comparable  Boolean                 @default(true)
  state       String                  @db.Text
  version     Int                     @default(1)
  createdAt   DateTime                @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  category    Category                @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  values      ProductAttributeValue[]

  @@unique([categoryId, code], map: "attribute_definition_category_code_key")
  @@unique([id, categoryId, valueType], map: "attribute_definition_identity_key")
  @@index([categoryId, state, code], map: "attribute_definition_category_state_code_idx")
  @@map("attribute_definition")
}

model CatalogProduct {
  id                     String                   @id @db.Uuid
  brandId                String?                  @map("brand_id") @db.Uuid
  manufacturerName       String?                  @map("manufacturer_name") @db.VarChar(200)
  originalPartNumber     String?                  @map("original_part_number") @db.VarChar(160)
  modification           String?                  @db.VarChar(160)
  slug                   String                   @unique(map: "catalog_product_slug_key") @db.VarChar(160)
  publicationState       String                   @map("publication_state") @db.Text
  publishedRevisionId    String?                  @map("published_revision_id") @db.Uuid
  pendingRevisionId      String?                  @map("pending_revision_id") @db.Uuid
  currentDraftRevisionId String?                  @map("current_draft_revision_id") @db.Uuid
  version                Int                      @default(1)
  createdAt              DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  brand                  Brand?                   @relation("CatalogProductBrand", fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  revisions              CatalogProductRevision[] @relation("CatalogProductRevisions")
  publishedRevision      CatalogProductRevision?  @relation("ProductPublishedRevision", fields: [publishedRevisionId, id], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  pendingRevision        CatalogProductRevision?  @relation("ProductPendingRevision", fields: [pendingRevisionId, id], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  currentDraftRevision   CatalogProductRevision?  @relation("ProductDraftRevision", fields: [currentDraftRevisionId, id], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  catalogImportRows      CatalogImportRow[]       @relation("CatalogImportMatchedProduct")
  catalogImportDecisions CatalogImportDecision[]  @relation("CatalogImportDecisionTarget")
  supplierMatchProposals ProductMatchProposal[]

  @@index([publicationState, updatedAt, id], map: "catalog_product_state_updated_id_idx")
  @@index([brandId, publicationState, id], map: "catalog_product_brand_state_id_idx")
  @@index([originalPartNumber, id], map: "catalog_product_part_number_id_idx")
  @@map("catalog_product")
}

model CatalogProductRevision {
  id                           String                   @id @db.Uuid
  productId                    String                   @map("product_id") @db.Uuid
  revisionNo                   Int                      @map("revision_no")
  sourceRevisionId             String?                  @map("source_revision_id") @db.Uuid
  brandId                      String?                  @map("brand_id") @db.Uuid
  categoryId                   String                   @map("category_id") @db.Uuid
  state                        String                   @db.Text
  displayName                  String                   @map("display_name") @db.VarChar(240)
  summary                      String?                  @db.VarChar(500)
  description                  String?                  @db.Text
  brandNameSnapshot            String?                  @map("brand_name_snapshot") @db.VarChar(160)
  brandSlugSnapshot            String?                  @map("brand_slug_snapshot") @db.VarChar(120)
  categoryNameSnapshot         String                   @map("category_name_snapshot") @db.VarChar(160)
  categorySlugSnapshot         String                   @map("category_slug_snapshot") @db.VarChar(120)
  manufacturerNameSnapshot     String?                  @map("manufacturer_name_snapshot") @db.VarChar(200)
  originalPartNumberSnapshot   String?                  @map("original_part_number_snapshot") @db.VarChar(160)
  modificationSnapshot         String?                  @map("modification_snapshot") @db.VarChar(160)
  createdByUserId              String                   @map("created_by_user_id") @db.Uuid
  createdAt                    DateTime                 @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  submittedByUserId            String?                  @map("submitted_by_user_id") @db.Uuid
  submittedAt                  DateTime?                @map("submitted_at") @db.Timestamptz(6)
  decidedByUserId              String?                  @map("decided_by_user_id") @db.Uuid
  decidedAt                    DateTime?                @map("decided_at") @db.Timestamptz(6)
  decision                     String?                  @db.Text
  decisionReason               String?                  @map("decision_reason") @db.VarChar(1000)
  expectedCatalogImportRows    CatalogImportRow[]       @relation("CatalogImportExpectedRevision")
  catalogImportDecisionResults CatalogImportDecision[]  @relation("CatalogImportDecisionResultRevision")
  publishedAt                  DateTime?                @map("published_at") @db.Timestamptz(6)
  product                      CatalogProduct           @relation("CatalogProductRevisions", fields: [productId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceRevision               CatalogProductRevision?  @relation("RevisionSource", fields: [sourceRevisionId, productId], references: [id, productId], onDelete: Restrict, onUpdate: Restrict)
  derivedRevisions             CatalogProductRevision[] @relation("RevisionSource")
  brand                        Brand?                   @relation("CatalogRevisionBrand", fields: [brandId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  category                     Category                 @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  createdBy                    StaffUser                @relation("CatalogRevisionCreator", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  submittedBy                  StaffUser?               @relation("CatalogRevisionSubmitter", fields: [submittedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy                    StaffUser?               @relation("CatalogRevisionReviewer", fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  publishedFor                 CatalogProduct[]         @relation("ProductPublishedRevision")
  pendingFor                   CatalogProduct[]         @relation("ProductPendingRevision")
  draftFor                     CatalogProduct[]         @relation("ProductDraftRevision")
  attributeValues              ProductAttributeValue[]
  media                        ProductMedia[]
  documents                    ProductDocumentVersion[]
  sourceRelations              ProductRelation[]        @relation("ProductRelationSource")
  targetRelations              ProductRelation[]        @relation("ProductRelationTarget")

  // Partial unique indexes for DRAFT and PENDING_REVIEW are SQL-only.
  @@unique([productId, revisionNo], map: "catalog_product_revision_product_no_key")
  @@unique([id, productId], map: "catalog_product_revision_id_product_key")
  @@unique([id, categoryId], map: "catalog_product_revision_id_category_key")
  @@index([productId, revisionNo(sort: Desc)], map: "catalog_product_revision_product_no_idx")
  @@index([state, createdAt, id], map: "catalog_product_revision_state_created_id_idx")
  @@index([categoryId, state, productId], map: "catalog_product_revision_category_state_product_idx")
  @@map("catalog_product_revision")
}

model CatalogImportRun {
  id                   String             @id @db.Uuid
  uploaderStaffUserId  String             @map("uploader_staff_user_id") @db.Uuid
  sourceFileObjectId   String             @map("source_file_object_id") @db.Uuid
  sourceFileVersionId  String             @map("source_file_version_id") @db.Uuid
  sourceFormat         String             @map("source_format") @db.Text
  sourceEncoding       String?            @map("source_encoding") @db.Text
  sourceDelimiter      String?            @map("source_delimiter") @db.Text
  state                String             @db.Text
  mapping              Json?              @db.JsonB
  parserVersion        String             @map("parser_version") @db.VarChar(32)
  sourceParseIssues    Json               @default("[]") @map("source_parse_issues") @db.JsonB
  mappingVersion       Int                @default(0) @map("mapping_version")
  uploadIdempotencyKey String             @map("upload_idempotency_key") @db.Uuid
  uploadRequestHash    Bytes              @map("upload_request_hash") @db.ByteA
  version              Int                @default(1)
  createdAt            DateTime           @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @default(dbgenerated("transaction_timestamp()")) @map("updated_at") @db.Timestamptz(6)
  uploader             StaffUser          @relation("CatalogImportUploader", fields: [uploaderStaffUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  sourceFileObject     FileObject         @relation("CatalogImportSourceObject", fields: [sourceFileObjectId, uploaderStaffUserId], references: [id, ownerStaffUserId], onDelete: Restrict, onUpdate: Restrict)
  sourceFileVersion    FileVersion        @relation("CatalogImportSourceVersion", fields: [sourceFileVersionId, sourceFileObjectId], references: [id, fileObjectId], onDelete: Restrict, onUpdate: Restrict)
  rows                 CatalogImportRow[]

  @@unique([uploaderStaffUserId, uploadIdempotencyKey], map: "catalog_import_run_uploader_key_key")
  @@index([uploaderStaffUserId, createdAt, id], map: "catalog_import_run_owner_created_id_idx")
  @@index([state, updatedAt, id], map: "catalog_import_run_state_updated_id_idx")
  @@map("catalog_import_run")
}

model CatalogImportRow {
  id                        String                  @id @db.Uuid
  importRunId               String                  @map("import_run_id") @db.Uuid
  sheetIndex                Int                     @map("sheet_index")
  sheetName                 String?                 @map("sheet_name") @db.VarChar(128)
  sourceRowNumber           Int                     @map("source_row_number")
  sourceCells               Json                    @map("source_cells") @db.JsonB
  normalizedCandidate       Json                    @default("{}") @map("normalized_candidate") @db.JsonB
  validationIssues          Json                    @default("[]") @map("validation_issues") @db.JsonB
  warnings                  Json                    @default("[]") @db.JsonB
  candidateState            String                  @map("candidate_state") @db.Text
  matchedProductId          String?                 @map("matched_product_id") @db.Uuid
  expectedProductVersion    Int?                    @map("expected_product_version")
  expectedCurrentRevisionId String?                 @map("expected_current_revision_id") @db.Uuid
  version                   Int                     @default(1)
  createdAt                 DateTime                @default(dbgenerated("transaction_timestamp()")) @map("created_at") @db.Timestamptz(6)
