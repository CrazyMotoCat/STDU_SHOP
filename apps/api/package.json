{
  "name": "@stdu/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "pnpm run db:generate && tsx watch src/main.ts",
    "build": "pnpm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "pnpm run db:generate && tsc --noEmit -p tsconfig.check.json",
    "db:generate": "node ../../scripts/prisma-generate.mjs",
    "db:validate": "prisma validate",
    "db:runtime-role:init": "node scripts/prepare-runtime-role.mjs",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "openapi:export": "node ../../scripts/openapi-export.mjs",
    "staff:bootstrap": "node ../../scripts/staff-access.mjs bootstrap",
    "staff:recover": "node ../../scripts/staff-access.mjs recover",
    "catalog:permissions:initialize": "node ../../scripts/catalog-permissions.mjs"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@nestjs/swagger": "12.0.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "ioredis": "6.0.0",
    "argon2": "0.45.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/pg": "8.23.1",
    "prisma": "7.10.1"
  }
}
