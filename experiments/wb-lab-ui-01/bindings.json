[
  {
    "id": "dash_mode",
    "read": {
      "enable": true,
      "channel": "stdu_lab/Source_Mode",
      "value": "[\"DEMO\", \"LIVE\", \"UNKNOWN\"].includes(val) ? val : \"UNKNOWN\""
    },
    "style": {
      "enable": true,
      "channel": "stdu_lab/Source_Mode",
      "value": "(val == 'DEMO') ? ';fill:#f5bd55' : (val == 'LIVE') ? ';fill:#43d59c' : ';fill:#a4b2c4'"
    }
  },
  {
