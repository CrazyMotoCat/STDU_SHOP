      "ImportDecisionResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/ImportDecision" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "additionalProperties": false
      },
      "ImportDecisionListResponse": {
        "type": "object",
