{
  "openapi": "3.1.0",
  "info": {
    "title": "STDU_SHOP R1-006 Catalog Import Staff API",
    "version": "0.1.0-proposed",
    "description": "Proposed staff-only manual CSV/XLSX catalog import. No public import API, automatic publication, supplier crawling, or quote specification import."
  },
  "x-contract-status": "PROPOSED",
  "x-staff-response-headers": {
    "Cache-Control": "no-store",
    "X-Content-Type-Options": "nosniff",
    "X-Request-Id": "server-generated UUID, also present in meta.requestId/error.requestId"
  },
  "x-import-authorization": {
    "ownerKey": "CatalogImportRun.uploaderStaffUserId",
    "defaultListScope": "authenticated caller only",
    "ownerRead": ["catalog.products.read"],
    "ownerWrite": ["catalog.products.read", "catalog.products.write"],
    "referenceRead": "Mapping, preview and row decisions additionally require catalog.references.read to resolve/revalidate ACTIVE Brand, Category and AttributeDefinition records.",
    "crossOwnerRead": {
      "status": "ACTIVE",
      "requiredFrozenSet": "all FROZEN R1-002 controlAdminRequiredPermissions",
      "evaluation": "effective union over the active staff user's assigned roles; never infer from role name",
      "additionalPermissions": ["catalog.products.read"],
      "roleNameAloneGrantsAccess": false,
      "denial": "404",
      "auditAction": "catalog.import.cross_owner.accessed"
    },
    "crossOwnerMutation": {
      "status": "ACTIVE",
      "requiredFrozenSet": "all FROZEN R1-002 controlAdminRequiredPermissions",
      "evaluation": "effective union over the active staff user's assigned roles; never infer from role name",
      "additionalPermissions": [
        "catalog.products.read",
        "catalog.products.write",
        "catalog.references.read"
      ],
      "roleNameAloneGrantsAccess": false,
      "denial": "404",
      "auditAction": "catalog.import.cross_owner.accessed",
      "mayMapPreviewAndDecideOtherRows": true
    }
  },
  "servers": [{ "url": "/" }],
  "tags": [{ "name": "catalog-import-staff" }],
  "security": [{ "staffCookie": [] }],
  "paths": {
    "/v1/staff/catalog/imports": {
      "post": {
        "tags": ["catalog-import-staff"],
        "operationId": "createCatalogImport",
        "summary": "Upload one private CSV/XLSX source and create an import run",
        "x-permission": "catalog.products.write",
        "x-additional-permissions": ["catalog.products.read"],
        "x-csrf": true,
        "x-audit": "catalog.import.created",
        "parameters": [
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": "CSV or XLSX, maximum 10 MiB."
                  },
                  "csvEncoding": {
                    "type": "string",
                    "enum": ["UTF-8", "WINDOWS-1251"],
                    "description": "CSV only; defaults to UTF-8 with BOM recognition. Windows-1251 must be explicit."
                  },
                  "csvDelimiter": {
                    "type": "string",
                    "enum": [",", ";", "\t"],
                    "description": "CSV only; omitted delimiter is accepted only when comma, semicolon, or tab is uniquely detected."
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created; source remains private and UNCHECKED.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "413": { "$ref": "#/components/responses/PayloadTooLarge" },
          "415": { "$ref": "#/components/responses/UnsupportedMediaType" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      },
      "get": {
        "tags": ["catalog-import-staff"],
        "operationId": "listCatalogImports",
        "summary": "List bounded staff catalog import runs",
        "x-permission": "catalog.products.read",
        "x-audit": "conditional catalog.import.cross_owner.accessed for cross-owner listing",
        "x-owner-scope": "own uploader runs by default; ownerStaffUserId may select another uploader only under x-import-authorization.crossOwnerRead",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed",
        "parameters": [
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Cursor" },
          { "$ref": "#/components/parameters/OwnerStaffUserId" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paged import runs.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportRunListResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      }
    },
    "/v1/staff/catalog/imports/{runId}": {
      "get": {
        "tags": ["catalog-import-staff"],
        "operationId": "getCatalogImport",
        "summary": "Read run summary and immutable source provenance",
        "x-permission": "catalog.products.read",
        "x-audit": "conditional catalog.import.cross_owner.accessed for cross-owner read; denied cross-owner lookup is DENIED",
        "x-owner-scope": "uploader-only; cross-owner exception per x-import-authorization.crossOwnerRead",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed",
        "parameters": [{ "$ref": "#/components/parameters/RunId" }],
        "responses": {
          "200": {
            "description": "Import run.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportRunResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/staff/catalog/imports/{runId}/mapping": {
      "put": {
        "tags": ["catalog-import-staff"],
        "operationId": "setCatalogImportMapping",
        "summary": "Set or correct explicit column/reference mappings before any row is terminal",
        "x-permission": "catalog.products.write",
        "x-additional-permissions": [
          "catalog.products.read",
          "catalog.references.read"
        ],
        "x-csrf": true,
        "x-audit": "catalog.import.mapping.changed",
        "x-owner-scope": "uploader-only; cross-owner exception per x-import-authorization.crossOwnerMutation",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed in the same transaction as mapping.changed",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ImportMappingRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Mapping saved; expected version incremented.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/v1/staff/catalog/imports/{runId}/preview": {
      "post": {
        "tags": ["catalog-import-staff"],
        "operationId": "previewOrResumeCatalogImport",
        "summary": "Apply saved mapping to stored raw rows or resume an incomplete preview",
        "x-permission": "catalog.products.write",
        "x-additional-permissions": [
          "catalog.products.read",
          "catalog.references.read"
        ],
        "x-csrf": true,
        "x-audit": "catalog.import.preview.completed",
        "x-owner-scope": "uploader-only; cross-owner exception per x-import-authorization.crossOwnerMutation",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed in the same transaction as preview.completed",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" }
        ],
        "responses": {
          "200": {
            "description": "Preview completed or partial from saved raw rows; no product is changed.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ImportRunResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/staff/catalog/imports/{runId}/rows": {
      "get": {
        "tags": ["catalog-import-staff"],
        "operationId": "listCatalogImportRows",
        "summary": "Read raw source rows before mapping and normalized preview after mapping",
        "x-permission": "catalog.products.read",
        "x-audit": "conditional catalog.import.cross_owner.accessed for cross-owner read; denied cross-owner lookup is DENIED",
        "x-owner-scope": "uploader-only; cross-owner exception per x-import-authorization.crossOwnerRead",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": {
            "description": "Cursor-paged import rows.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportRowListResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/v1/staff/catalog/imports/{runId}/rows/{rowId}/decision": {
      "post": {
        "tags": ["catalog-import-staff"],
        "operationId": "decideCatalogImportRow",
        "summary": "Decide one row and create/prepare a draft only",
        "x-permission": "catalog.products.write",
        "x-additional-permissions": [
          "catalog.products.read",
          "catalog.references.read"
        ],
        "x-csrf": true,
        "x-audit": "catalog.import.row.decided",
        "x-owner-scope": "uploader-only; cross-owner exception per x-import-authorization.crossOwnerMutation",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed in the same transaction as row.decided",
        "x-conflict-semantics": {
          "httpStatus": 409,
          "codes": ["IMPORT_ROW_CONFLICT", "IDENTITY_CONFLICT"],
          "candidateState": "CONFLICT",
          "decisionOutcome": "CONFLICT",
          "decisionConflictCode": "the same exact 409 code is persisted for idempotent replay",
          "auditOutcome": "DENIED",
          "successAudit": false,
          "catalogMutation": "rolled back before the conflict record transaction",
          "conflictRecordTransaction": "Atomically persists row CONFLICT, one CatalogImportDecision outcome CONFLICT with conflictCode, and one catalog.import.row.decided denial AuditEvent linked by auditEventId.",
          "sameKeySameHashReplay": "Return the stored 409 outcome and conflictCode without inserting another decision or audit event.",
          "sameKeyDifferentHash": "Return 409 IDEMPOTENCY_KEY_REUSED without inserting another decision."
        },
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/RowId" },
          { "$ref": "#/components/parameters/Origin" },
          { "$ref": "#/components/parameters/CsrfToken" },
          { "$ref": "#/components/parameters/IdempotencyKey" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImportRowDecisionRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "One row decision recorded; accepted rows create/prepare draft only.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportDecisionResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": {
            "description": "For ACCEPT_CREATE/ACCEPT_REVISION domain conflict: after catalog mutation rollback, atomically commit row candidateState=CONFLICT, one decision outcome=CONFLICT with persisted conflictCode and one DENIED decision AuditEvent; then return 409 with that code. Same-key/same-hash replay returns the stored conflict without duplicate decision or audit. VERSION_CONFLICT for a stale request version leaves row and decision history unchanged.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Error" }
              }
            }
          },
          "503": { "$ref": "#/components/responses/Unavailable" }
        }
      }
    },
    "/v1/staff/catalog/imports/{runId}/rows/{rowId}/history": {
      "get": {
        "tags": ["catalog-import-staff"],
        "operationId": "getCatalogImportRowHistory",
        "summary": "Read append-only decisions for one row",
        "x-permission": "catalog.products.read",
        "x-audit": "conditional catalog.import.cross_owner.accessed for cross-owner read; denied cross-owner lookup is DENIED",
        "x-owner-scope": "uploader-only; cross-owner exception per x-import-authorization.crossOwnerRead",
        "x-cross-owner-audit": "catalog.import.cross_owner.accessed",
        "parameters": [
          { "$ref": "#/components/parameters/RunId" },
          { "$ref": "#/components/parameters/RowId" },
          { "$ref": "#/components/parameters/PageSize" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": {
            "description": "Append-only row decision history.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImportDecisionListResponse"
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "staffCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-stdu_staff",
        "description": "FROZEN R1-002 production cookie. Explicit loopback development uses stdu_staff_dev. Generated clients use credentials:include and never construct auth tokens."
      }
    },
    "parameters": {
      "Origin": {
        "name": "Origin",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "format": "uri" },
        "description": "Exact configured trusted staff web origin."
      },
      "CsrfToken": {
        "name": "X-CSRF-Token",
        "in": "header",
        "required": true,
        "schema": {
          "type": "string",
          "minLength": 43,
          "maxLength": 43,
          "pattern": "^[A-Za-z0-9_-]{43}$"
        },
        "description": "Session-bound FROZEN R1-002 CSRF token; never logged or stored."
      },
      "RunId": {
        "name": "runId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "RowId": {
        "name": "rowId",
        "in": "path",
        "required": true,
        "schema": { "type": "string", "format": "uuid" }
      },
      "PageSize": {
        "name": "pageSize",
        "in": "query",
        "required": false,
        "schema": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 50
        }
      },
      "Cursor": {
        "name": "cursor",
        "in": "query",
        "required": false,
        "schema": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      },
      "OwnerStaffUserId": {
        "name": "ownerStaffUserId",
        "in": "query",
        "required": false,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Optional owner filter. Omitted means the authenticated caller only; selecting another uploader requires x-import-authorization.crossOwnerRead."
      },
      "IdempotencyKey": {
        "name": "Idempotency-Key",
        "in": "header",
        "required": true,
        "schema": { "type": "string", "format": "uuid" },
        "description": "Same key/body replays stored result; changed body returns IDEMPOTENCY_KEY_REUSED."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["code", "message", "requestId"],
        "properties": {
          "code": { "type": "string" },
          "message": { "type": "string" },
          "requestId": { "type": "string", "format": "uuid" },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["field", "code"],
              "properties": {
                "field": { "type": "string" },
                "code": { "type": "string" }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "Meta": {
        "type": "object",
        "required": ["requestId"],
        "properties": {
          "requestId": { "type": "string", "format": "uuid" },
          "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
          "nextCursor": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      },
      "ImportRun": {
        "type": "object",
        "required": [
          "id",
          "state",
          "sourceFormat",
          "sourceEncoding",
          "sourceDelimiter",
          "sourceSha256",
          "originalFilename",
          "parserVersion",
          "uploadedAt",
          "version",
          "mappingVersion",
          "rowCounts",
          "sourceParseIssues"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "state": {
            "type": "string",
            "enum": [
              "SOURCE_READY",
              "SOURCE_PARTIAL",
              "MAPPED",
              "PREVIEWING",
              "PREVIEW_READY",
              "PREVIEW_PARTIAL",
              "COMPLETED",
              "COMPLETED_WITH_ISSUES"
            ]
          },
          "sourceFormat": { "type": "string", "enum": ["CSV", "XLSX"] },
          "sourceSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "originalFilename": { "type": "string", "maxLength": 255 },
          "uploadedAt": { "type": "string", "format": "date-time" },
          "version": { "type": "integer", "minimum": 1 },
          "mappingVersion": { "type": "integer", "minimum": 0 },
          "rowCounts": {
            "type": "object",
            "required": [
              "total",
              "sourceInvalid",
              "header",
              "ignored",
              "invalid",
              "ready",
              "applied",
              "held",
              "rejected"
            ],
            "properties": {
              "total": { "type": "integer", "minimum": 0 },
              "invalid": { "type": "integer", "minimum": 0 },
              "ready": { "type": "integer", "minimum": 0 },
              "applied": { "type": "integer", "minimum": 0 },
              "held": { "type": "integer", "minimum": 0 },
              "rejected": { "type": "integer", "minimum": 0 },
              "sourceInvalid": { "type": "integer", "minimum": 0 },
              "header": { "type": "integer", "minimum": 0 },
              "ignored": { "type": "integer", "minimum": 0 }
            },
            "additionalProperties": false
          },
          "sourceEncoding": {
            "type": ["string", "null"],
            "enum": ["UTF-8", "WINDOWS-1251", null]
          },
          "sourceDelimiter": {
            "type": ["string", "null"],
            "enum": [",", ";", "\t", null]
          },
          "parserVersion": { "type": "string", "maxLength": 32 },
          "sourceParseIssues": {
            "type": "array",
            "maxItems": 256,
            "items": { "$ref": "#/components/schemas/RowIssue" },
            "description": "Parser diagnostics only; never includes file or cell contents."
          }
        },
        "additionalProperties": false
      },
      "ImportRow": {
        "type": "object",
        "required": [
          "id",
          "sheetIndex",
          "sheetName",
          "sourceRowNumber",
          "sourceCells",
          "normalizedCandidate",
          "validationIssues",
          "warnings",
          "candidateState",
          "version"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "sheetIndex": { "type": "integer", "minimum": 0 },
          "sheetName": { "type": ["string", "null"], "maxLength": 128 },
          "sourceRowNumber": { "type": "integer", "minimum": 1 },
          "sourceCells": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["columnIndex", "cellType", "rawValue"],
              "properties": {
                "columnIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 127
                },
                "cellType": {
                  "type": "string",
                  "enum": ["TEXT", "NUMBER", "BOOLEAN", "FORMULA", "BLANK"]
                },
                "rawValue": { "type": "string", "maxLength": 4000 },
                "numberFormat": { "type": "string", "maxLength": 64 }
              },
              "additionalProperties": false
            },
            "maxItems": 128
          },
          "normalizedCandidate": {
            "$ref": "#/components/schemas/NormalizedCandidate"
          },
          "validationIssues": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RowIssue" }
          },
          "warnings": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/RowIssue" }
          },
          "candidateState": {
            "type": "string",
            "enum": [
              "INVALID",
              "NEEDS_MAPPING",
              "HEADER",
              "IGNORED",
              "NEW",
              "EXACT_MATCH",
              "NO_DEDUP_KEY",
              "DUPLICATE_IN_RUN",
              "ARCHIVED_MATCH",
              "CONFLICT",
              "APPLIED",
              "REJECTED",
              "HELD"
            ]
          },
          "matchedProductId": { "type": ["string", "null"], "format": "uuid" },
          "expectedProductVersion": {
            "type": ["integer", "null"],
            "minimum": 1
          },
          "expectedCurrentRevisionId": {
            "type": ["string", "null"],
            "format": "uuid"
          },
          "version": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": false
      },
      "NormalizedCandidate": {
        "type": "object",
        "description": "Partial when a row is invalid or needs mapping.",
        "properties": {
          "displayName": { "type": ["string", "null"], "maxLength": 240 },
          "summary": { "type": ["string", "null"], "maxLength": 500 },
          "description": { "type": ["string", "null"] },
          "brandId": { "type": ["string", "null"], "format": "uuid" },
          "manufacturerName": { "type": ["string", "null"], "maxLength": 200 },
          "originalPartNumber": {
            "type": ["string", "null"],
            "maxLength": 160
          },
          "modification": { "type": ["string", "null"], "maxLength": 160 },
          "categoryId": { "type": ["string", "null"], "format": "uuid" },
          "attributes": {
            "type": "array",
            "maxItems": 256,
            "items": { "$ref": "#/components/schemas/NormalizedAttribute" }
          }
        },
        "additionalProperties": false
      },
      "NormalizedAttribute": {
        "type": "object",
        "required": ["categoryId", "attributeDefinitionId", "valueType"],
        "properties": {
          "categoryId": { "type": "string", "format": "uuid" },
          "attributeDefinitionId": { "type": "string", "format": "uuid" },
          "valueType": {
            "type": "string",
            "enum": ["TEXT", "DECIMAL", "INTEGER", "BOOLEAN", "ENUM"]
          },
          "valueText": { "type": "string", "maxLength": 240 },
          "valueDecimal": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$",
            "not": { "pattern": "^-0(?:\\.0+)?$" }
          },
          "valueInteger": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "valueBoolean": { "type": "boolean" },
          "valueEnumCode": { "type": "string", "maxLength": 80 }
        },
        "oneOf": [
          {
            "required": ["valueText"],
            "properties": { "valueType": { "const": "TEXT" } },
            "not": {
              "anyOf": [
                { "required": ["valueDecimal"] },
                { "required": ["valueInteger"] },
                { "required": ["valueBoolean"] },
                { "required": ["valueEnumCode"] }
              ]
            }
          },
          {
            "required": ["valueDecimal"],
            "properties": { "valueType": { "const": "DECIMAL" } },
            "not": {
              "anyOf": [
                { "required": ["valueText"] },
                { "required": ["valueInteger"] },
                { "required": ["valueBoolean"] },
                { "required": ["valueEnumCode"] }
              ]
            }
          },
          {
            "required": ["valueInteger"],
            "properties": { "valueType": { "const": "INTEGER" } },
            "not": {
              "anyOf": [
                { "required": ["valueText"] },
                { "required": ["valueDecimal"] },
                { "required": ["valueBoolean"] },
                { "required": ["valueEnumCode"] }
              ]
            }
          },
          {
            "required": ["valueBoolean"],
            "properties": { "valueType": { "const": "BOOLEAN" } },
            "not": {
              "anyOf": [
                { "required": ["valueText"] },
                { "required": ["valueDecimal"] },
                { "required": ["valueInteger"] },
                { "required": ["valueEnumCode"] }
              ]
            }
          },
          {
            "required": ["valueEnumCode"],
            "properties": { "valueType": { "const": "ENUM" } },
            "not": {
              "anyOf": [
                { "required": ["valueText"] },
                { "required": ["valueDecimal"] },
                { "required": ["valueInteger"] },
                { "required": ["valueBoolean"] }
              ]
            }
          }
        ],
        "additionalProperties": false
      },
      "RowIssue": {
        "type": "object",
        "required": ["field", "code"],
        "properties": {
          "field": { "type": "string", "maxLength": 120 },
          "code": { "type": "string", "maxLength": 64 },
          "message": { "type": "string", "maxLength": 240 }
        },
        "additionalProperties": false
      },
      "ImportMappingRequest": {
        "type": "object",
        "description": "CSV encoding and delimiter are fixed at upload and cannot be changed in this request. Each sheet has independent fixed/category/brand and attribute mappings; a fixed reference conflicts with any same-target column or explicit reference mapping.",
        "required": [
          "expectedVersion",
          "mappingSchemaVersion",
          "sheetMappings"
        ],
        "properties": {
          "expectedVersion": { "type": "integer", "minimum": 1 },
          "mappingSchemaVersion": { "type": "integer", "const": 1 },
          "sheetMappings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": [
                "sheetIndex",
                "headerRowNumber",
                "columnMappings",
                "referenceMappings"
              ],
              "properties": {
                "sheetIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 19
                },
                "headerRowNumber": { "type": "integer", "minimum": 1 },
                "fixedCategoryId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Optional per-sheet fixed ACTIVE Category ID. When set, categoryId column/reference mapping is forbidden."
                },
                "fixedBrandId": {
                  "type": "string",
                  "format": "uuid",
                  "description": "Optional per-sheet fixed ACTIVE Brand ID. When set, brandId column/reference mapping is forbidden."
                },
                "columnMappings": {
                  "type": "array",
                  "maxItems": 128,
                  "items": {
                    "type": "object",
                    "required": ["columnIndex", "target"],
                    "properties": {
                      "columnIndex": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 127
                      },
                      "target": {
                        "type": "string",
                        "enum": [
                          "displayName",
                          "summary",
                          "description",
                          "brandId",
                          "manufacturerName",
                          "originalPartNumber",
                          "modification",
                          "categoryId",
                          "attribute"
                        ]
                      },
                      "attributeDefinitionId": {
                        "type": "string",
                        "format": "uuid"
                      },
                      "categoryId": { "type": "string", "format": "uuid" }
                    },
                    "additionalProperties": false
                  }
                },
                "referenceMappings": {
                  "type": "array",
                  "maxItems": 500,
                  "items": {
                    "type": "object",
                    "required": ["target", "sourceValue", "targetId"],
                    "properties": {
                      "target": {
                        "type": "string",
                        "enum": ["brandId", "categoryId"]
                      },
                      "sourceValue": { "type": "string", "maxLength": 240 },
                      "targetId": { "type": "string", "format": "uuid" }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false,
              "uniqueItems": true,
              "description": "sheetIndex is unique. A sheet may use fixedCategoryId instead of categoryId column/reference mappings and fixedBrandId instead of brandId column/reference mappings; setting a fixed value and any mapping for the same target is rejected with 400 VALIDATION_ERROR. Fixed references must be ACTIVE. Different sheets may use different fixed references. With fixedCategoryId, attribute mappings must use that exact categoryId. Attribute mappings remain bound to exact categoryId and attributeDefinitionId pairs; no code-based inheritance."
            }
          }
        },
        "additionalProperties": false
      },
      "ImportRowDecisionRequest": {
        "type": "object",
        "required": ["expectedRowVersion", "action"],
        "properties": {
          "expectedRowVersion": { "type": "integer", "minimum": 1 },
          "action": {
            "type": "string",
            "enum": ["ACCEPT_CREATE", "ACCEPT_REVISION", "REJECT", "HOLD"]
          },
          "expectedProductVersion": { "type": "integer", "minimum": 1 },
          "expectedCurrentRevisionId": { "type": "string", "format": "uuid" },
          "reasonCode": {
            "type": "string",
            "enum": [
              "DUPLICATE_REVIEWED",
              "SOURCE_INCOMPLETE",
              "DATA_CORRECTED",
              "OTHER"
            ]
          }
        },
        "additionalProperties": false
      },
      "ImportDecision": {
        "type": "object",
        "required": [
          "id",
          "rowId",
          "action",
          "outcome",
          "conflictCode",
          "mappingVersion",
          "createdAt"
        ],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "rowId": { "type": "string", "format": "uuid" },
          "action": {
            "type": "string",
            "enum": ["ACCEPT_CREATE", "ACCEPT_REVISION", "REJECT", "HOLD"]
          },
          "outcome": {
            "type": "string",
            "enum": ["APPLIED", "REJECTED", "HELD", "CONFLICT"]
          },
          "conflictCode": {
            "type": ["string", "null"],
            "enum": ["IMPORT_ROW_CONFLICT", "IDENTITY_CONFLICT", null],
            "description": "Persisted 409 code for outcome=CONFLICT; null otherwise."
          },
          "mappingVersion": { "type": "integer", "minimum": 0 },
          "targetProductId": { "type": ["string", "null"], "format": "uuid" },
          "resultRevisionId": { "type": ["string", "null"], "format": "uuid" },
          "reasonCode": {
            "type": ["string", "null"],
            "enum": [
              "DUPLICATE_REVIEWED",
              "SOURCE_INCOMPLETE",
              "DATA_CORRECTED",
              "OTHER",
              null
            ]
          },
          "createdAt": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false,
        "description": "For accepted domain commands that conflict, outcome=CONFLICT and conflictCode are persisted with row candidateState=CONFLICT and a linked DENIED AuditEvent; the HTTP response is 409 with the stored conflictCode. Same-key/same-hash replay returns the same code without duplicate decision/audit. It is not a success audit or catalog mutation."
      },
      "ImportRunResponse": {
        "type": "object",
        "required": ["data", "meta"],
        "properties": {
          "data": { "$ref": "#/components/schemas/ImportRun" },
          "meta": { "$ref": "#/components/schemas/Meta" }
        },
        "additionalProperties": false
      },
      "ImportRunListResponse": {
        "type": "object",
