  "finalization": {
    "contractContentChanged": true,
    "description": "The owner-approved 1.0.0 package is preserved as baseVersion. Contract Amendment 01, owner-approved on 2026-10-27, corrects capability-only upload route resolution, permits only one-way capability revocation by clearing hash and expiry, and raises the OpenAPI maxBytes ceiling to match the server-selected 50 MiB ENGINEERING_DOCUMENTS profile; all other approved business, security, RBAC and lifecycle rules are unchanged."
  },
  "baseVersion": "1.0.0",
  "amendments": [
    {
      "id": "R1-010 Contract Amendment 01",
      "version": "1.0.1",
      "approvedOn": "2026-10-27",
      "approvalStatement": "Owner approved capability-only upload routes, preserved the public create receipt without Inquiry UUID, required unique capability-hash lookup and one-way capability revocation, and raised the OpenAPI maxBytes ceiling to 50 MiB while keeping profile selection server-controlled.",
      "changes": [
        "POST /v1/public/inquiry-attachments/upload-intents",
        "PUT /v1/public/inquiry-attachments/upload-intents/{intentId}/content",
        "DELETE /v1/public/inquiry-attachments/upload-intents/{intentId}",
        "UploadIntentReceipt.data.maxBytes.maximum=52428800",
        "Unique nullable Inquiry.uploadCapabilityHash lookup index",
        "One-way server-side capability revocation by clearing hash and expiry; no public or staff route"
      ],
      "preserves": [
        "Public create receipt contains only publicReference, createdAt and message",
        "OD-010-01…05 behavior apart from these explicit corrections",
        "RBAC, lifecycle, personal-data rules, upload formats and limits, quarantine and launch gates"
      ],
      "scope": "No production migration, deployment, real permission grant or public launch authorization."
    }
  ]
