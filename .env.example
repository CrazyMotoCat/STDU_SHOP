# Copy through `pnpm env:init`; the script generates local-only random passwords.
# Do not put production credentials in this example or commit .env.local.
APP_ENV=development
POSTGRES_USER=stdu
POSTGRES_DB=stdu
POSTGRES_HOST_PORT=15432
REDIS_HOST_PORT=16379
POSTGRES_PASSWORD=
REDIS_PASSWORD=
DATABASE_URL=
MIGRATION_DATABASE_URL=
STAFF_DATABASE_URL=
STAFF_COMPOSE_DATABASE_URL=
REDIS_URL=
STDU_RUNTIME_PASSWORD=
SESSION_HMAC_KEY=
RATE_LIMIT_KEY=
STAFF_ORIGINS=http://127.0.0.1:3000
COOKIE_PROFILE=loopback
PUBLIC_WEB_ORIGIN=
# Web SEO is generated at build time; keep disabled outside the public production site.
PUBLIC_SITE_INDEXING_ENABLED=false
TRUSTED_PROXY_ADDRESS=
API_INTERNAL_URL=http://127.0.0.1:3001
FILE_STORAGE_ROOT=.local/files
