{
  "name": "stdu-shop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "env:init": "node scripts/env-init.mjs",
    "toolchain:check": "node scripts/tasks.mjs toolchain",
    "infra:up": "node scripts/ops.mjs infra-up",
    "infra:stop": "node scripts/ops.mjs infra-stop",
    "dev": "node scripts/ops.mjs dev",
    "compose:up": "node scripts/ops.mjs compose-up",
    "compose:stop": "node scripts/ops.mjs compose-stop",
    "compose:status": "node scripts/ops.mjs status",
    "lint": "node scripts/tasks.mjs lint",
    "format:check": "node scripts/tasks.mjs format-check",
    "format": "node scripts/tasks.mjs format",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "test": "node scripts/tasks.mjs test",
    "test:r1-002b": "node apps/api/scripts/run-r1-002b-runtime.mjs",
    "test:r1-006b": "node apps/api/scripts/run-r1-006b-runtime.mjs",
    "test:r1-007b": "node apps/api/scripts/run-r1-007b-runtime.mjs",
    "test:r1-010b": "node apps/api/scripts/run-r1-010b-runtime.mjs",
    "build": "node scripts/tasks.mjs build",
    "smoke": "node scripts/smoke.mjs compose",
    "smoke:host": "node scripts/smoke.mjs host",
    "ui:smoke": "node scripts/ui-smoke.mjs",
    "rfq:ui:smoke": "node scripts/rfq-ui-smoke.mjs",
    "catalog:ui:smoke": "node scripts/catalog-ui-smoke.mjs",
    "db:validate": "pnpm --filter @stdu/api db:validate",
    "db:runtime-role:init": "pnpm --filter @stdu/api db:runtime-role:init",
    "db:migrate:dev": "pnpm --filter @stdu/api db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @stdu/api db:migrate:deploy",
    "openapi:export": "node scripts/openapi-export.mjs",
    "supplier:openapi:export": "node scripts/supplier-openapi-export.mjs",
    "supplier:contract:check": "pnpm supplier:openapi:export && node scripts/supplier-openapi-contract.mjs",
    "contract:check": "node scripts/contracts.mjs check",
    "contract:test": "node --test scripts/contracts.node.mjs",
    "catalog:contract:generate": "node docs/contracts/generate-R1-004-openapi.mjs",
    "catalog:contract:check": "node docs/contracts/generate-R1-004-openapi.mjs --check && node docs/contracts/check-R1-004.mjs",
    "catalog:contract:test": "node --test docs/contracts/check-R1-004.test.mjs",
    "catalog:route:check": "node scripts/catalog-route-check.mjs",
    "catalog:runtime:check": "pnpm --filter @stdu/api exec node scripts/run-r1-004b-migration-check.mjs",
    "client:generate": "node scripts/contracts.mjs generate-client",
    "inquiry:openapi:export": "node scripts/inquiry-openapi-export.mjs",
    "inquiry:contract:check": "pnpm inquiry:openapi:export && node scripts/validate-openapi.mjs docs/contracts/R1-010-inquiries.openapi.json .local/contracts/generated-inquiry.openapi.json && node scripts/inquiry-openapi-contract.mjs docs/contracts/R1-010-inquiries.openapi.json .local/contracts/generated-inquiry.openapi.json",
    "catalog:client:generate": "pnpm exec openapi-typescript docs/contracts/R1-004-catalog.openapi.json --output packages/catalog-client/src/schema.d.ts",
    "catalog:client:check": "pnpm exec openapi-typescript docs/contracts/R1-004-catalog.openapi.json --output packages/catalog-client/src/schema.d.ts --check",
    "catalog:check": "pnpm catalog:contract:check && pnpm catalog:route:check && pnpm catalog:client:check"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "13.1.0",
    "@eslint/js": "10.0.1",
    "@types/node": "24.10.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "selfsigned": "5.5.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
